# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values: this repo is public.

# --- Claude ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Twilio (the A2P-approved number's account) ---
TWILIO_ACCOUNT_SID=
# An API key made for this bot (Twilio Console → Account → API keys):
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# The A2P-registered Messaging Service the number belongs to (preferred), or the number itself:
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Optional: the account's auth token, which turns on Twilio signature checks for incoming texts.
TWILIO_AUTH_TOKEN=

# --- Redis: added automatically when you connect Upstash Redis in Vercel's Storage tab ---
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- The bot ---
# Your cell. Drafts, booking requests and hand-offs are texted here, and you control the bot by texting from it.
OWNER_PHONE=
# A long random string you make up. Goes in the Twilio webhook URL (?secret=) and the GitHub secret.
WEBHOOK_SECRET=
# Password for the control page at /api/admin.
ADMIN_PASSWORD=
# Leave as true until you've watched it work. Set to false to actually text leads.
DRY_RUN=true
# false = review mode (you approve each reply). Text AUTO ON / AUTO OFF to change it anytime.
AUTO_SEND=false

# --- Optional tuning (defaults shown) ---
# TIMEZONE=America/Phoenix
# CAMPAIGN_DAYS=10
# DAILY_FIRST_TEXT_CAP=50
# FIRST_TEXTS_PER_TICK=4
# NUDGE_DAYS=3,6
# SEND_START_HOUR=8
# SEND_END_HOUR=20

# --- Wording (defaults in lib/business.ts) ---
# BUSINESS_NAME=Lustra Services
# REP_NAME=Thomas
# BUSINESS_FACTS=
# BOOKING_RULES=
# FIRST_TEXT=Hi {first}, it's {rep} with {business}. ... Reply STOP to opt out.
# NUDGE_TEXTS=first nudge || second nudge
